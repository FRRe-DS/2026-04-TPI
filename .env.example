# Backend principal: crear una copia local como .env.
PORT=3001
INTERNAL_API_TOKEN=reemplazar-por-un-secreto-compartido-de-al-menos-32-caracteres
LOG_LEVEL=info

# MySQL (puede coincidir con bd/.env).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=despacho
DB_CONNECTION_LIMIT=5

# M2: valida el estado ACTIVO de la cuenta antes de dar de alta una solicitud.
M2_URL=http://localhost:3002
M2_TOKEN=

# Verificación remota de los JWT que M3 envía a POST /ofertas/:ofertaId/respuesta.
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=bajer
JWT_CLAIM_IDENTIDAD=sub
JWT_CLAIM_ROLES=realm_access.roles
JWT_CLAIM_CONDUCTOR=conductor_id
JWT_CLAIM_SCOPES=scope

# URLs base y rutas acordadas con cada módulo. Confirmar rutas pendientes en sus contratos.
M3_URL=http://localhost:3003
M3_TOKEN=
M3_RUTA_ENVIAR_OFERTAS=/api/v1/integration/m5/offers
M3_RUTA_CONDUCTOR_DETALLE=/api/v1/integration/drivers/dispatch-info
M4_URL=http://localhost:3004
M4_TOKEN=
M4_RUTA_BUSCAR=/api/v1/conductores/cercanos
M4_RUTA_ESTIMACION=/api/v1/rutas/estimacion
M6_URL=http://localhost:3006
M6_TOKEN=
M6_RUTA_CREAR_VIAJE=/trips
M7_URL=http://localhost:3007
M7_TOKEN=
M7_RUTA_ESTIMACION=/api/v1/tarifas/estimaciones

TAMANO_TANDA=3
ESPERA_TANDA_MS=20000
VIGENCIA_OFERTA_MS=30000
PLAZO_BUSQUEDA_MS=180000
REINTENTO_DESPACHO_MS=5000
