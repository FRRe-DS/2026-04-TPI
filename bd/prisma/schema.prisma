// Esquema M5: solicitudes persistidas en MySQL mediante Prisma.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Solicitud {
  idSolicitud   String   @id @default(uuid())
  idCliente     String
  origenLat     Float
  origenLng     Float
  destinoLat    Float
  destinoLng    Float
  tipoVehiculo  String
  tipoActivacion String  @default("Inmediata")
  reservaId     String?  @unique
  conductorId   String?
  estado        String   @default("PENDIENTE_ASIGNACION")
  creadaEn      DateTime @default(now())
}
