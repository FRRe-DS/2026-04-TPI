{
  "name": "M3 POST /api/v1/integration/drivers/dispatch-info - conductor habilitado y disponible con su vehículo. Contrato acordado entre G04 y M3 del consorcio A (no está en el repositorio de la cátedra)",
  "request": {
    "method": "POST",
    "urlPath": "/api/v1/integration/drivers/dispatch-info",
    "bodyPatterns": [{ "matchesJsonPath": "$.conductor_id" }]
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "conductor_id": "{{jsonPath request.body '$.conductor_id'}}",
      "habilitado": true,
      "disponible": true,
      "vehiculo": {
        "vehiculo_id": "5b0e7c1a-9d2f-4e3a-8b7c-6d5e4f3a2b1c",
        "tipo_vehiculo": "AUTO"
      }
    },
    "transformers": ["response-template"]
  }
}
