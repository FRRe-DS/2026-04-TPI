{
  "name": "M2 GET /api/v1/clientes/{clienteId}/estado-cuenta - cliente ACTIVO (esquema EstadoCuenta del contrato oficial)",
  "request": {
    "method": "GET",
    "urlPathPattern": "/api/v1/clientes/[0-9a-fA-F-]{36}/estado-cuenta",
    "headers": { "Authorization": { "matches": "Bearer .+" } }
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "clienteId": "{{request.pathSegments.[3]}}",
      "estado": "ACTIVO",
      "bloqueosVigentes": []
    },
    "transformers": ["response-template"]
  }
}
